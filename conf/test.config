/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/phylophoenix -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

singularity {
  enabled    = true
  autoMounts = true

}
docker.enabled = false

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    //input  = 'https://raw.githubusercontent.com/nf-core/test-datasets/viralrecon/samplesheet/samplesheet_test_illumina_amplicon.csv'
    input  = "assets/testoutput_phoenix/Directory_samplesheet.csv"

    // Genome references
    //genome = 'R64-1-1'
}


//trace {
  //enabled = true
  //file    = "trace_phyml.tsv"
  //fields  = 'task_id,process,attempt,status,exit,container'
//}


process {
    // Apply to any process whose name includes 'phyml' (case-insensitive)
    withName: /(?i)phyml.*/ {
      // Point to the Galaxy SIF (remote https URL)
      container = 'https://depot.galaxyproject.org/singularity/phyml%3A3.3.20220408--h37cc20f_1'  // [1](https://github.com/StaPH-B)

    }
}


